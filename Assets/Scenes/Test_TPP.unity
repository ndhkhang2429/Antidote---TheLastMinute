  m_Script: {fileID: 11500000, guid: d48cb4b8e47ff5a4b93ed7b6872ee3c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  slides:
  - image: {fileID: 21300000, guid: b6de82fc28f27e6488845990c582873f, type: 3}
    storyText: 'It began with a sickness no one could explain.

      Within days,
      the city fell into chaos.'
    displayDuration: 3
  - image: {fileID: 21300000, guid: 5f1768b4a47a79f4e9adde20c2993b74, type: 3}
    storyText: 'The survivors fled to Coldstone Medical Center...

      The last
      place they believed could still save them.'
    displayDuration: 3
  - image: {fileID: 21300000, guid: 8f38d04a7b44d614eaf17ddaefdee5c5, type: 3}
    storyText: 'But hope died behind those walls.

      The hospital became another
      feeding ground.'
    displayDuration: 3
  - image: {fileID: 21300000, guid: b1a48169fe97b1b44bf7fa1f0256ff58, type: 3}
    storyText: 'Hours later...

      Only silence remained.'
    displayDuration: 3.5
